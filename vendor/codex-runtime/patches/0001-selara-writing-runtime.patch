+#[derive(Debug)]
+pub(crate) struct LoginPersistenceGuard {
+    home: PathBuf,
+    generation: String,
+    cancelled: std::sync::atomic::AtomicBool,
+}
+impl LoginPersistenceGuard {
+    pub(crate) fn cancel(&self) {
+        self.cancelled
+            .store(true, std::sync::atomic::Ordering::Release);
+        // Serialize cancellation with any callback already committing.
+        if let Ok(_lock) = home_lock(&self.home, ".auth.lock")
+            && generation(&self.home).ok().as_ref() == Some(&self.generation)
+        {
+            let _ = advance_generation(&self.home);
+        }
+    }
+}
+pub(crate) fn begin_login_persistence(
+    home: &Path,
+) -> std::io::Result<Option<Arc<LoginPersistenceGuard>>> {
+    if !auth_persistence_locking_enabled() {
+        return Ok(None);
+    }
+    let _lock = home_lock(home, ".auth.lock")?;
+    // Beginning a newer login invalidates an older in-flight callback.
+    advance_generation(home)?;
+    Ok(Some(Arc::new(LoginPersistenceGuard {
+        home: home.canonicalize()?,
+        generation: generation(home)?,
+        cancelled: std::sync::atomic::AtomicBool::new(false),
+    })))
+}
+#[derive(Debug)]
+struct LockedAuthStorage {
+    codex_home: PathBuf,
+    backend: Arc<dyn AuthStorageBackend>,
+}
+impl AuthStorageBackend for LockedAuthStorage {
+    fn load(&self) -> std::io::Result<Option<AuthDotJson>> {
+        let _lock = home_lock(&self.codex_home, ".auth.lock")?;
+        self.backend.load()
+    }
+    fn save(&self, auth: &AuthDotJson) -> std::io::Result<()> {
+        let _lock = home_lock(&self.codex_home, ".auth.lock")?;
+        // Advance first: an interrupted write still invalidates pending callbacks.
+        advance_generation(&self.codex_home)?;
+        self.backend.save(auth)
+    }
+    fn delete(&self) -> std::io::Result<bool> {
+        let _lock = home_lock(&self.codex_home, ".auth.lock")?;
+        advance_generation(&self.codex_home)?;
+        self.backend.delete()
+    }
+    fn update(&self, updater: AuthUpdater) -> std::io::Result<()> {
+        let _lock = home_lock(&self.codex_home, ".auth.lock")?;
+        let mut auth = self
+            .backend
+            .load()?
+            .ok_or(std::io::Error::other("Token data is not available."))?;
+        updater(&mut auth)?;
+        advance_generation(&self.codex_home)?;
+        self.backend.save(&auth)
+    }
+    fn save_guarded(
+        &self,
+        auth: &AuthDotJson,
+        guard: &LoginPersistenceGuard,
+    ) -> std::io::Result<()> {
+        let _lock = home_lock(&self.codex_home, ".auth.lock")?;
+        if guard.cancelled.load(std::sync::atomic::Ordering::Acquire)
+            || self.codex_home.canonicalize()? != guard.home
+            || generation(&self.codex_home)? != guard.generation
+        {
+            return Err(std::io::Error::other(
+                "Login was canceled or authentication changed while login was pending",
+            ));
+        }
+        advance_generation(&self.codex_home)?;
+        self.backend.save(auth)
+    }
+}
