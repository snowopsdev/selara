+fn generation(home: &Path) -> std::io::Result<String> {
+    match std::fs::read_to_string(home.join(".auth.generation")) {
+        Ok(value) if value.len() == 32 && value.bytes().all(|byte| byte.is_ascii_hexdigit()) => {
+            Ok(value)
+        }
+        // Corruption invalidates pending callbacks. The next mutation replaces
+        // it atomically with a new unpredictable generation; logout stays usable.
+        Ok(_) => Ok(String::new()),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(String::new()),
+        Err(e) => Err(e),
+    }
+}
+fn advance_generation(home: &Path) -> std::io::Result<()> {
+    let next = format!("{:032x}", rand::random::<u128>());
+    atomic_auth_write(home, ".auth.generation", next.as_bytes())
