diff --git a/codex-rs/selara-writing/src/main.rs b/codex-rs/selara-writing/src/main.rs
new file mode 100644
index 0000000..7934f2c
--- /dev/null
+++ b/codex-rs/selara-writing/src/main.rs
@@ -0,0 +1,636 @@
+//! Deliberately separate from the Codex agent session. Only pinned upstream auth,
+//! managed auth policy, model discovery, and Responses SSE transport are used.
+//! No thread store, instruction discovery, tool registry, hooks, plugins, skills,
+//! MCP, environment roots, or execution methods are constructed on this path.
+use anyhow::{Context, Result, bail, ensure};
+use codex_api::{
+    AuthProvider, Compression, ModelsClient, Provider, ReqwestTransport, ResponseEvent,
+    ResponsesClient, RetryConfig,
+};
+use codex_config::{ConfigLayerStack, ConfigLoadOptions, LoaderOverrides, NoopThreadConfigLoader};
+use codex_login::{
+    AuthConfig, AuthCredentialsStoreMode, AuthKeyringBackendKind, AuthManager, AuthRouteConfig,
+    CodexAuth,
+};
+use codex_protocol::config_types::ForcedLoginMethod;
+use codex_protocol::openai_models::ModelInfo;
+use futures::StreamExt;
+use http::{HeaderMap, HeaderValue};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, HashMap},
+    path::PathBuf,
+    sync::Arc,
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader},
+    sync::mpsc,
+};
+
+const CHATGPT_BASE: &str = "https://chatgpt.com/backend-api/";
+const CODEX_BASE: &str = "https://chatgpt.com/backend-api/codex";
+const MAX_FRAME: u64 = 4 * 1024 * 1024;
+const MAX_THREADS: usize = 32;
+const TURN_TIMEOUT: Duration = Duration::from_secs(120);
+
+type Out = mpsc::Sender<Value>;
+
+#[derive(Default, Deserialize)]
+struct AuthSettings {
+    cli_auth_credentials_store: Option<AuthCredentialsStoreMode>,
+    forced_login_method: Option<ForcedLoginMethod>,
+    forced_chatgpt_workspace_id: Option<Value>,
+    #[serde(default)]
+    features: BTreeMap<String, Value>,
+}
+
+#[derive(Clone)]
+struct Settings {
+    home: PathBuf,
+    overrides: LoaderOverrides,
+    endpoint: String,
+}
+
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args == ["--version"] {
+        println!("selara-codex {}", env!("CARGO_PKG_VERSION"));
+        return Ok(());
+    }
+    let expected = [
+        "app-server",
+        "--listen",
+        "stdio://",
+        "--selara-writing-mode",
+    ];
+    ensure!(
+        args.iter().take(4).map(String::as_str).eq(expected),
+        "this bundled runtime requires app-server --listen stdio:// --selara-writing-mode"
+    );
+    #[allow(unused_mut)]
+    let mut endpoint = CODEX_BASE.to_owned();
+    #[allow(unused_mut)]
+    let mut overrides = LoaderOverrides {
+        ignore_project_config: true,
+        ignore_user_and_project_exec_policy_rules: true,
+        ..Default::default()
+    };
+    if args.len() != 4 {
+        #[cfg(feature = "selara-test-support")]
+        {
+            ensure!(
+                args.len() == 8 && args[4] == "--test-endpoint" && args[6] == "--test-policy-dir",
+                "invalid test arguments"
+            );
+            ensure!(
+                args[5].starts_with("http://127.0.0.1:"),
+                "test endpoint must be loopback"
+            );
+            endpoint = args[5].clone();
+            overrides = LoaderOverrides::with_managed_config_path_for_tests(
+                PathBuf::from(&args[7]).join("managed_config.toml"),
+            );
+            overrides.ignore_project_config = true;
+            overrides.ignore_user_and_project_exec_policy_rules = true;
+        }
+        #[cfg(not(feature = "selara-test-support"))]
+        bail!("unsupported runtime arguments");
+    }
+    // Runs before creating any runtime threads. Ignore legacy endpoint, auth,
+    // model, and feature environment overrides; only CODEX_HOME selects a store.
+    for (key, _) in std::env::vars_os() {
+        let name = key.to_string_lossy();
+        if (name.starts_with("CODEX_") && name != "CODEX_HOME") || name.starts_with("OPENAI_") {
+            // SAFETY: this is single-threaded process startup, before Tokio.
+            unsafe {
+                std::env::remove_var(key);
+            }
+        }
+    }
+    let home = codex_utils_home_dir::find_codex_home()?;
+    std::fs::create_dir_all(&home)?;
+    let home = std::fs::canonicalize(home)?;
+    codex_login::auth::enable_auth_persistence_locking();
+    tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()?
+        .block_on(run(Settings {
+            home,
+            overrides,
+            endpoint,
+        }))
+}
+
+impl Settings {
+    async fn layers(
+        &self,
+        cloud: codex_config::CloudConfigBundleLoader,
+    ) -> Result<ConfigLayerStack> {
+        Ok(codex_config::loader::load_config_layers_state(
+            codex_exec_server::LOCAL_FS.as_ref(),
+            &self.home,
+            None,
+            &[],
+            ConfigLoadOptions {
+                loader_overrides: self.overrides.clone(),
+                strict_config: false,
+                cloud_config_bundle: cloud,
+            },
+            &NoopThreadConfigLoader,
+        )
+        .await?)
+    }
+    fn auth_config(&self, stack: &ConfigLayerStack) -> Result<AuthConfig> {
+        // Deserialize only the account/store allowlist. All other configuration
+        // values are inert and cannot enter requests or construct extensions.
+        let settings: AuthSettings = stack.effective_config().try_into()?;
+        let requirements = stack.requirements();
+        ensure!(
+            requirements.network.is_none(),
+            "managed network constraints require a transport policy unsupported by Selara writing mode"
+        );
+        if let Some(required) = &requirements.chatgpt_base_url {
+            ensure!(
+                required.value.trim_end_matches('/') == CHATGPT_BASE.trim_end_matches('/'),
+                "managed ChatGPT endpoint is incompatible with Selara's fixed transport"
+            );
+        }
+        let workspaces = match settings.forced_chatgpt_workspace_id {
+            None => None,
+            Some(Value::String(s)) => Some(vec![s]),
+            Some(Value::Array(a)) => Some(
+                a.into_iter()
+                    .map(|s| {
+                        s.as_str()
+                            .map(str::to_owned)
+                            .context("invalid workspace restriction")
+                    })
+                    .collect::<Result<Vec<_>>>()?,
+            ),
+            _ => bail!("invalid workspace restriction"),
+        }
+        .map(|a| {
+            a.into_iter()
+                .map(|s| s.trim().to_owned())
+                .filter(|s| !s.is_empty())
+                .collect::<Vec<_>>()
+        })
+        .filter(|a| !a.is_empty());
+        let secret_store = requirements
+            .feature_requirements
+            .as_ref()
+            .and_then(|s| s.value.entries.get("secret_auth_storage").copied())
+            .or_else(|| {
+                settings
+                    .features
+                    .get("secret_auth_storage")
+                    .and_then(Value::as_bool)
+            })
+            .unwrap_or(cfg!(windows));
+        codex_login::default_client::set_default_client_residency_requirement(
+            *requirements.enforce_residency.get(),
+        );
+        let respect_system_proxy = requirements
+            .feature_requirements
+            .as_ref()
+            .and_then(|s| s.value.entries.get("respect_system_proxy").copied())
+            .or_else(|| {
+                settings
+                    .features
+                    .get("respect_system_proxy")
+                    .and_then(Value::as_bool)
+            })
+            .unwrap_or(false);
+        let route = codex_http_client::HttpClientFactory::new(if respect_system_proxy {
+            codex_http_client::OutboundProxyPolicy::RespectSystemProxy
+        } else {
+            codex_http_client::OutboundProxyPolicy::ReqwestDefault
+        });
+        let config = AuthConfig {
+            codex_home: self.home.clone(),
+            auth_credentials_store_mode: requirements
+                .cli_auth_credentials_store
+                .as_ref()
+                .map(|s| s.value)
+                .or(settings.cli_auth_credentials_store)
+                .unwrap_or_default(),
+            keyring_backend_kind: if secret_store {
+                AuthKeyringBackendKind::Secrets
+            } else {
+                AuthKeyringBackendKind::Direct
+            },
+            forced_login_method: settings.forced_login_method,
+            forced_chatgpt_workspace_id: workspaces,
+            managed_auth_policy: requirements.managed_auth_policy(),
+            chatgpt_base_url: Some(CHATGPT_BASE.into()),
+            auth_route_config: AuthRouteConfig::from_http_client_factory(route),
+        };
+        config.validate()?;
+        Ok(config)
+    }
+    async fn auth(&self) -> Result<(AuthConfig, Arc<AuthManager>)> {
+        let local = self.layers(Default::default()).await?;
+        let config = self.auth_config(&local)?;
+        let manager = AuthManager::shared_for_selara_writing(config.clone()).await;
+        // Retain enterprise requirements through the upstream authenticated
+        // loader. No cloud execution configuration is interpreted by this bin.
+        #[cfg(feature = "selara-test-support")]
+        if self.endpoint != CODEX_BASE {
+            return Ok((config, manager));
+        }
+        let cloud = codex_cloud_config::cloud_config_bundle_loader(
+            manager,
+            CHATGPT_BASE.into(),
+            self.home.clone(),
+            config.auth_route_config.http_client_factory().clone(),
+        );
+        let stack = self.layers(cloud).await?;
+        let config = self.auth_config(&stack)?;
+        let manager = AuthManager::shared_for_selara_writing(config.clone()).await;
+        Ok((config, manager))
+    }
+    fn provider(&self) -> Provider {
+        Provider {
+            name: "OpenAI".into(),
+            base_url: self.endpoint.clone(),
+            query_params: None,
+            headers: HeaderMap::new(),
+            retry: RetryConfig {
+                max_attempts: 2,
+                base_delay: Duration::from_millis(250),
+                retry_429: true,
+                retry_5xx: true,
+                retry_transport: true,
+            },
+            stream_idle_timeout: Duration::from_secs(60),
+        }
+    }
+}
+
+struct RequestAuth(HeaderMap);
+impl AuthProvider for RequestAuth {
+    fn add_auth_headers(&self, headers: &mut HeaderMap) {
+        headers.extend(self.0.clone());
+    }
+}
+
+async fn transport(
+    settings: &Settings,
+) -> Result<(ReqwestTransport, Provider, Arc<dyn AuthProvider>)> {
+    let (config, manager) = settings.auth().await?;
+    ensure!(
+        config.is_login_method_allowed(ForcedLoginMethod::Chatgpt),
+        "managed policy does not permit ChatGPT login"
+    );
+    manager.reload().await;
+    let auth = manager
+        .auth()
+        .await
+        .context("Sign in with ChatGPT to use Selara")?;
+    ensure!(
+        matches!(auth, CodexAuth::Chatgpt(_)),
+        "Selara requires a persisted ChatGPT login"
+    );
+    ensure!(
+        config.allows_auth(&auth),
+        "ChatGPT account is restricted by managed policy"
+    );
+    let mut headers = HeaderMap::new();
+    headers.insert(
+        http::header::AUTHORIZATION,
+        HeaderValue::from_str(&format!("Bearer {}", auth.get_token()?))?,
+    );
+    headers.insert(
+        "ChatGPT-Account-Id",
+        HeaderValue::from_str(
+            &auth
+                .get_account_id()
+                .context("ChatGPT account id is missing")?,
+        )?,
+    );
+    let client = codex_login::default_client::create_client_for_route_async(
+        config.auth_route_config.http_client_factory().clone(),
+        settings.endpoint.clone(),
+        codex_http_client::ClientRouteClass::Api,
+    )
+    .await?;
+    Ok((
+        ReqwestTransport::from_http_client(client),
+        settings.provider(),
+        Arc::new(RequestAuth(headers)),
+    ))
+}
+
+async fn models(settings: &Settings) -> Result<Vec<ModelInfo>> {
+    let (transport, provider, auth) = transport(settings).await?;
+    let url = ModelsClient::<ReqwestTransport>::request_url(&provider, env!("CARGO_PKG_VERSION"));
+    let (mut list, _) = ModelsClient::new(transport, provider, auth)
+        .list_models(url, HeaderMap::new())
+        .await?;
+    list.retain(|m| {
+        serde_json::to_value(&m.input_modalities)
+            .ok()
+            .and_then(|v| v.as_array().map(|a| a.iter().any(|v| v == "text")))
+            .unwrap_or(false)
+    });
+    list.sort_by_key(|m| m.priority);
+    Ok(list)
+}
+
+struct WritingThread {
+    model: String,
+    instructions: String,
+    turn: Option<(String, tokio::task::JoinHandle<()>)>,
+    used: bool,
+}
+struct Login {
+    id: String,
+    cancel: codex_login::ShutdownHandle,
+}
+
+async fn emit(out: &Out, method: &str, params: Value) {
+    let _ = out
+        .send(json!({"jsonrpc":"2.0", "method":method,"params":params}))
+        .await;
+}
+async fn reply(out: &Out, id: Value, result: Result<Value>) {
+    let value = match result {
+        Ok(v) => json!({"jsonrpc":"2.0","id":id,"result":v}),
+        Err(e) => json!({"jsonrpc":"2.0","id":id,"error":{"code":-32602,"message":e.to_string()}}),
+    };
+    let _ = out.send(value).await;
+}
+fn fields(params: &Value, allowed: &[&str]) -> Result<()> {
+    let map = params.as_object().context("params must be an object")?;
+    ensure!(
+        map.keys().all(|key| allowed.contains(&key.as_str())),
+        "unsupported parameters in writing mode"
+    );
+    Ok(())
+}
+fn required<'a>(p: &'a Value, key: &str) -> Result<&'a str> {
+    p.get(key)
+        .and_then(Value::as_str)
+        .with_context(|| format!("missing {key}"))
+}
+
+async fn run(settings: Settings) -> Result<()> {
+    let (out, mut rx) = mpsc::channel::<Value>(64);
+    let writer = tokio::spawn(async move {
+        let mut stdout = tokio::io::stdout();
+        while let Some(v) = rx.recv().await {
+            stdout.write_all(v.to_string().as_bytes()).await?;
+            stdout.write_all(b"\n").await?;
+            stdout.flush().await?;
+        }
+        Ok::<_, std::io::Error>(())
+    });
+    let mut stdin = BufReader::new(tokio::io::stdin());
+    let mut initialized = false;
+    let mut threads: HashMap<String, WritingThread> = HashMap::new();
+    let mut login: Option<Login> = None;
+    let mut catalog: Vec<ModelInfo> = Vec::new();
+    loop {
+        let mut frame = String::new();
+        let count = (&mut stdin)
+            .take(MAX_FRAME + 1)
+            .read_line(&mut frame)
+            .await?;
+        if count == 0 {
+            break;
+        }
+        if count as u64 > MAX_FRAME || !frame.ends_with('\n') {
+            bail!("invalid or oversized RPC frame");
+        }
+        let request: Value = serde_json::from_str(&frame)?;
+        let method = required(&request, "method")?;
+        if request.get("id").is_none() {
+            ensure!(
+                method == "initialized" && initialized,
+                "unsupported notification"
+            );
+            continue;
+        }
+        let id = request["id"].clone();
+        ensure!(id.is_number() || id.is_string(), "invalid request id");
+        let p = request.get("params").cloned().unwrap_or(json!({}));
+        let result:Result<Value>=async {
+            if method=="initialize" {
+                ensure!(!initialized,"already initialized");
+                fields(&p,&["clientInfo","capabilities","selaraWritingMode"])?;
+                ensure!(p.get("selaraWritingMode")==Some(&json!(1)),"Selara writing mode version 1 is required");
+                initialized=true;
+                return Ok(json!({"userAgent":format!("selara-codex/{}",env!("CARGO_PKG_VERSION")),"selaraWritingMode":1}));
+            }
+            ensure!(initialized,"initialize is required");
+            match method {
+                "account/read" => {
+                    fields(&p,&["refreshToken"])?;
+                    let (config,manager)=settings.auth().await?;
+                    if p["refreshToken"]==true { manager.refresh_token().await?; }
+                    manager.reload().await;
+                    let account=match manager.auth_cached() {
+                        Some(auth) if matches!(auth,CodexAuth::Chatgpt(_)) && config.allows_auth(&auth) => json!({"type":"chatgpt","email":auth.get_account_email(),"planType":auth.account_plan_type()}),
+                        Some(auth) if auth.is_api_key_auth() => json!({"type":"apiKey"}),
+                        _=>Value::Null,
+                    };
+                    Ok(json!({"account":account,"requiresOpenaiAuth":true}))
+                },
+                "account/login/start" => {
+                    fields(&p,&["type"])?; ensure!(p["type"]=="chatgpt","only ChatGPT login is supported");
+                    let (config,_)=settings.auth().await?;
+                    ensure!(config.is_login_method_allowed(ForcedLoginMethod::Chatgpt),"managed policy does not permit ChatGPT login");
+                    if let Some(previous)=login.take(){previous.cancel.shutdown();}
+                    let mut options=codex_login::ServerOptions::new(settings.home.clone(),codex_login::oauth_client_id(),config.effective_chatgpt_workspaces(),config.auth_credentials_store_mode,config.keyring_backend_kind,config.auth_route_config);
+                    options.open_browser=false;
+                    let server=codex_login::run_login_server(options)?;
+                    let login_id=uuid::Uuid::new_v4().to_string();
+                    let result=json!({"type":"chatgpt","loginId":login_id,"authUrl":server.auth_url});
+                    login=Some(Login{id:login_id.clone(),cancel:server.cancel_handle()});
+                    let output=out.clone();
+                    tokio::spawn(async move { let done=server.block_until_done().await; emit(&output,"account/login/completed",json!({"loginId":login_id,"success":done.is_ok(),"error":done.err().map(|_|"ChatGPT login did not complete")})).await; });
+                    catalog.clear(); Ok(result)
+                },
+                "account/login/cancel" => {
+                    fields(&p,&["loginId"])?;
+                    let login_id=required(&p,"loginId")?;
+                    ensure!(login.as_ref().is_some_and(|l|l.id==login_id),"unknown login id");
+                    if let Some(current)=login.take(){current.cancel.shutdown();} Ok(json!({"status":"canceled"}))
+                },
+                "account/logout" => {
+                    fields(&p,&[])?;
+                    if let Some(current)=login.take(){current.cancel.shutdown();}
+                    for thread in threads.values_mut(){ if let Some((_,handle))=thread.turn.take(){handle.abort();} }
+                    threads.clear(); catalog.clear();
+                    // Shared-account logout covers official Codex stores for
+                    // this home even when cloud configuration is unavailable.
+                    #[cfg(feature="selara-test-support")]
+                    codex_login::auth::logout_selara_test_stores(&settings.home)?;
+                    #[cfg(not(feature="selara-test-support"))]
+                    codex_login::auth::logout_selara_all_stores(&settings.home)?;
+                    emit(&out,"account/updated",json!({"authMode":null,"planType":null})).await;
+                    Ok(json!({}))
+                },
+                "model/list" => {
+                    fields(&p,&["cursor","limit","includeHidden"])?;
+                    ensure!(p.get("cursor").is_none_or(Value::is_null),"unsupported model cursor");
+                    catalog=models(&settings).await?;
+                    let data:Vec<_>=catalog.iter().map(|m|json!({"id":m.slug,"model":m.slug,"displayName":m.display_name,"description":m.description,"hidden":serde_json::to_value(m.visibility).ok()!=Some(json!("list")),"isDefault":catalog.first().is_some_and(|x|x.slug==m.slug),"inputModalities":["text"],"supportedReasoningEfforts":m.supported_reasoning_levels,"defaultReasoningEffort":m.default_reasoning_level})).collect();
+                    Ok(json!({"data":data,"nextCursor":null}))
+                },
+                "thread/start" => {
+                    fields(&p,&["ephemeral","model","baseInstructions"])?;
+                    ensure!(p["ephemeral"]==true,"writing threads must be ephemeral");
+                    ensure!(threads.len()<MAX_THREADS,"too many writing threads");
+                    let model=required(&p,"model")?.to_owned();
+                    ensure!(!model.is_empty()&&model.len()<128,"invalid model");
+                    let instructions=required(&p,"baseInstructions")?.to_owned();
+                    ensure!(instructions.len()<1024*1024,"instructions too long");
+                    let thread_id=uuid::Uuid::new_v4().to_string();
+                    threads.insert(thread_id.clone(),WritingThread{model,instructions,turn:None,used:false});
+                    Ok(json!({"thread":{"id":thread_id,"ephemeral":true},"modelProvider":"openai"}))
+                },
+                "turn/start" => {
+                    fields(&p,&["threadId","input","model","effort"])?;
+                    let thread_id=required(&p,"threadId")?.to_owned();
+                    let thread=threads.get_mut(&thread_id).context("unknown writing thread")?;
+                    ensure!(!thread.used,"writing threads allow a single text turn");
+                    if let Some(model)=p.get("model"){ensure!(model==&thread.model,"model must match the writing thread");}
+                    let input=p["input"].as_array().context("text input is required")?;
+                    ensure!(!input.is_empty() && input.len()<=32,"invalid input count");
+                    let mut text=String::new();
+                    for item in input { fields(item,&["type","text","text_elements"])?; ensure!(item["type"]=="text","only text input is supported"); ensure!(item.get("text_elements").is_none_or(|v|v.as_array().is_some_and(Vec::is_empty)),"text annotations are unsupported"); text.push_str(required(item,"text")?); }
+                    ensure!(!text.trim().is_empty(),"text input is empty");
+                    let effort=p.get("effort").cloned();
+                    let body=json!({"model":thread.model,"instructions":thread.instructions,"input":[{"type":"message","role":"user","content":[{"type":"input_text","text":text}]}],"tools":[],"tool_choice":"none","parallel_tool_calls":false,"store":false,"stream":true});
+                    let turn_id=uuid::Uuid::new_v4().to_string();
+                    // Queue acknowledgement before any task can emit notifications.
+                    reply(&out,id.clone(),Ok(json!({"turn":{"id":turn_id,"status":"inProgress","items":[],"error":null}}))).await;
+                    let output=out.clone(); let settings=settings.clone(); let tid=thread_id.clone(); let turn=turn_id.clone();
+                    let handle=tokio::spawn(async move {
+                        let result=tokio::time::timeout(TURN_TIMEOUT,complete(&settings,body,effort)).await;
+                        match result {
+                            Ok(Ok((text,usage))) => {
+                                emit(&output,"item/completed",json!({"threadId":tid,"turnId":turn,"item":{"id":uuid::Uuid::new_v4().to_string(),"type":"agentMessage","text":text}})).await;
+                                if let Some(usage)=usage { emit(&output,"thread/tokenUsage/updated",json!({"threadId":tid,"turnId":turn,"tokenUsage":{"last":usage,"total":usage,"modelContextWindow":null}})).await; }
+                                emit(&output,"turn/completed",json!({"threadId":tid,"turn":{"id":turn,"status":"completed","error":null}})).await;
+                            },
+                            error => { let message=match error {Ok(Err(e))=>e.to_string(),_=>"writing turn timed out".into()}; emit(&output,"turn/completed",json!({"threadId":tid,"turn":{"id":turn,"status":"failed","error":{"message":message}}})).await; }
+                        }
+                    });
+                    thread.used=true; thread.turn=Some((turn_id,handle));
+                    Ok(json!({"_alreadyReplied":true}))
+                },
+                "turn/interrupt" => {
+                    fields(&p,&["threadId","turnId"])?;
+                    let thread_id=required(&p,"threadId")?; let turn_id=required(&p,"turnId")?;
+                    let thread=threads.get_mut(thread_id).context("unknown writing thread")?;
+                    ensure!(thread.turn.as_ref().is_some_and(|(id,_)|id==turn_id),"unknown writing turn");
+                    if let Some((_,handle))=thread.turn.take(){handle.abort();}
+                    emit(&out,"turn/completed",json!({"threadId":thread_id,"turn":{"id":turn_id,"status":"interrupted","error":null}})).await;
+                    Ok(json!({}))
+                },
+                "thread/unsubscribe" => {
+                    fields(&p,&["threadId"])?;
+                    if let Some(mut thread)=threads.remove(required(&p,"threadId")?) && let Some((_,handle))=thread.turn.take(){handle.abort();}
+                    Ok(json!({"status":"unsubscribed"}))
+                },
+                _=>bail!("method is unavailable in Selara writing mode"),
+            }
+        }.await;
+        if !matches!(&result,Ok(v) if v.get("_alreadyReplied")==Some(&json!(true))) {
