+/// Sign out every official Codex auth backend for this selected home. This is
+/// independent of cloud availability and never touches another application's
+/// credential namespace. Partial deletion is an error, never a successful logout.
+pub fn logout_selara_all_stores(home: &Path) -> std::io::Result<bool> {
+    logout_selara_with_store(home, Arc::new(DefaultKeyringStore))
+}
+
+#[cfg(feature = "selara-test-support")]
+pub fn logout_selara_test_stores(home: &Path) -> std::io::Result<bool> {
+    logout_selara_with_store(
+        home,
+        Arc::new(codex_keyring_store::tests::MockKeyringStore::default()),
+    )
+}
+
+fn logout_selara_with_store(home: &Path, keyring: Arc<dyn KeyringStore>) -> std::io::Result<bool> {
+    let _lock = home_lock(home, ".auth.lock")?;
+    advance_generation(home)?;
+    let backends: Vec<Box<dyn AuthStorageBackend>> = vec![
+        Box::new(FileAuthStorage::new(home.to_path_buf())),
+        Box::new(DirectKeyringAuthStorage::new(
+            home.to_path_buf(),
+            keyring.clone(),
+        )),
+        Box::new(SecretsKeyringAuthStorage::new(home.to_path_buf(), keyring)),
+        Box::new(EphemeralAuthStorage::new(home.to_path_buf())),
+    ];
+    let mut removed = false;
+    let mut errors = Vec::new();
+    for backend in backends {
+        match backend.delete() {
+            Ok(deleted) => removed |= deleted,
+            Err(error) => errors.push(error.to_string()),
+        }
+    }
+    if errors.is_empty() {
+        Ok(removed)
+    } else {
+        Err(std::io::Error::other(format!(
+            "Some Codex authentication stores could not be cleared: {}",
+            errors.join("; ")
+        )))
+    }
+}
