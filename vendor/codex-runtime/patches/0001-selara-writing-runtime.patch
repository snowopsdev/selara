+        }
+    }
+    if let Some(login) = login {
+        login.cancel.shutdown();
+    }
+    for (_, mut thread) in threads {
+        if let Some((_, handle)) = thread.turn.take() {
+            handle.abort();
+        }
+    }
+    drop(out);
+    writer.await??;
+    Ok(())
+}
+
+async fn complete(
+    settings: &Settings,
+    mut body: Value,
+    effort: Option<Value>,
+) -> Result<(String, Option<Value>)> {
+    // Validate against authenticated upstream discovery, never a baked-in catalog.
+    let catalog = models(settings).await?;
+    let model = catalog
+        .iter()
+        .find(|m| Some(m.slug.as_str()) == body["model"].as_str())
+        .context("model is unavailable for this ChatGPT account")?;
+    if let Some(effort) = effort {
+        ensure!(
+            model
+                .supported_reasoning_levels
+                .iter()
+                .any(|r| serde_json::to_value(&r.effort).ok() == Some(effort.clone())),
+            "unsupported reasoning effort"
+        );
+        body["reasoning"] = json!({"effort":effort});
+    }
+    let (transport, mut provider, auth) = transport(settings).await?;
+    // A gateway/transport error may arrive after the backend accepted a
+    // generation. Never replay this non-idempotent POST on ambiguous failures.
+    provider.retry.retry_5xx = false;
+    provider.retry.retry_transport = false;
+    let mut stream = ResponsesClient::new(transport, provider, auth)
+        .stream(body, HeaderMap::new(), Compression::None, None)
+        .await?;
+    let mut text = String::new();
+    let mut completed = false;
+    let mut usage = None;
+    while let Some(event) = stream.next().await {
+        match event? {
+            ResponseEvent::OutputItemDone(item) => {
+                let item = serde_json::to_value(item)?;
+                match item["type"].as_str() {
+                    Some("message")
+                        if item["role"] == "assistant"
+                            && (item["phase"].is_null() || item["phase"] == "final_answer") =>
+                    {
+                        for part in item["content"]
+                            .as_array()
+                            .context("invalid assistant content")?
+                        {
+                            ensure!(
+                                part["type"] == "output_text",
+                                "non-text output is unsupported"
+                            );
+                            text.push_str(required(part, "text")?);
+                        }
+                    }
+                    Some("message" | "reasoning") => {}
+                    _ => bail!("tool or non-text output is unavailable in writing mode"),
+                }
+            }
+            ResponseEvent::Completed { token_usage, .. } => {
+                completed = true;
+                usage=token_usage.map(|u|json!({"inputTokens":u.input_tokens,"cachedInputTokens":u.cached_input_tokens,"outputTokens":u.output_tokens,"reasoningOutputTokens":u.reasoning_output_tokens,"totalTokens":u.total_tokens}));
+                break;
+            }
+            ResponseEvent::ToolCallInputDelta { .. } => {
+                bail!("tool output is unavailable in writing mode")
+            }
+            _ => {}
+        }
+    }
+    ensure!(
+        completed,
+        "response stream ended before successful completion"
+    );
+    ensure!(
+        !text.trim().is_empty(),
+        "response contained no completed assistant text"
+    );
+    Ok((text, usage))
+}
