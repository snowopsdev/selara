+fn home_lock(home: &Path, name: &str) -> std::io::Result<File> {
+    std::fs::create_dir_all(home)?;
+    let mut options = OpenOptions::new();
+    options.create(true).read(true).write(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let file = options.open(home.canonicalize()?.join(name))?;
+    file.lock()?;
+    Ok(file)
