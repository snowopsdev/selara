{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selara",
  "version": "0.5.0",
  "identifier": "dev.snowops.selara",
  "build": {
    "beforeDevCommand": "npm run prepare-sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Selara Settings",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/selara",
      "binaries/selara-codex"
    ],
    "resources": {
      "runtime-notices/": "runtime-notices/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/snowopsdev/selara/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2RkRFNTdFRjc3NDRBMUYKUldRZlNuVDNmdVg5eG0yZE5jQkROR3UxYjRINkFQU3hnMVQyNEZXQVRKZU80ZFhKaWJsZHpkZ2oK"
    }
  }
}
