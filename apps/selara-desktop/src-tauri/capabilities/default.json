{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Selara desktop",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "allow-get-config",
    "allow-save-config",
    "allow-save-config-section",
    "allow-api-key-source",
    "allow-store-api-key",
    "allow-clear-api-key",
    "allow-config-path",
    "allow-chatgpt-auth-status",
    "allow-chatgpt-login",
    "allow-chatgpt-logout",
    "allow-list-chatgpt-models",
    "allow-list-provider-models"
  ]
}
